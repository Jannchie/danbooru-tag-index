__pycache__/
.venv/
venv/

# Build artifacts. Everything here is reproducible: data/index/* from the
# metadata database (stage 1), *_name_map.json from *_names.json plus the
# committed LLM output.
data/index/
# 扫描进行中还会有 .duckdb.wal,所以是 duckdb* 而不是 duckdb
data/*.duckdb*
data/translations/*_names.json
data/translations/*_name_map.json
data/translations/display_names.json
data/translations/_zh_work/
data/translations/_char_work/
# 审查工作目录:输入可从数据库和名称映射重新生成(每批约 1,100 行,20 批),
# 输出是花钱买来的判断,留着当审计线索 —— 它们已经蒸馏进 zh_supplement/zh_rejected,
# 但保留原始答案才能回头查某条修正是谁给的、批次里的锚点长什么样。
data/translations/_zh_review/in_*.json
data/translations/_zh_review/nulls_in.json
# 同理:分片输入可由 general_zh + 数据库重新切出,fix*.json 是买来的判断,留作审计。
data/translations/_review_general/shard*.tsv
data/translations/_review2/*.tsv
site/
logs/

# NOT ignored, and must stay that way -- these cost real money to produce and
# cannot be regenerated from any input in this repo:
#   data/translations/han_language_overrides.json
#   data/translations/{character,copyright}_official.json
#   data/translations/zh_supplement.json
#   data/translations/zh_manual.json
#   data/translations/general_zh.json
#   data/translations/general_manual.json
